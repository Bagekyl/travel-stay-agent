# Server-only Dify application API key used by /api/chat.
DIFY_API_KEY=replace_with_dify_app_api_key

# Optional Dify API base URL; the proxy defaults to this public endpoint.
DIFY_API_BASE_URL=https://api.dify.ai/v1

# Used only by offline Places/Routes scripts; configure the same variable
# separately as a secret in the imported Dify Chatflow for runtime Routes calls.
GOOGLE_MAPS_API_KEY=replace_with_google_maps_api_key
